# Copy to .env (or export in your shell) and fill in the keys for the providers
# you want to use. Any provider you don't configure is simply unavailable.
#
#   mock:   no key needed -- a deterministic fake model for demos and tests.
#   ollama: local, no key (set OLLAMA_URL if not http://localhost:11434).

# ---- cloud / API providers (each optional) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DASHSCOPE_API_KEY=
OPENROUTER_API_KEY=

# ---- optional tuning ----
#ESCALATION_TIMEOUT=1200            # ollama request timeout (s)
#ESCALATION_CLOUD_TIMEOUT=120       # cloud request timeout (s)
#ESCALATION_CLOUD_MAX_TOKENS=8000   # max output tokens per cloud call
#ESCALATION_OPENAI_BASE=            # override the OpenAI-compatible endpoint for groq:
#ESCALATION_NUM_CTX=16384           # ollama context size
#GVS_WS_ROOT=                       # where task workspaces are created (default: ./runs/ws)
#GVS_MAX_ITERS=10                   # default manager iterations per task
#GVS_MAX_TASKS=12                   # default live task-list cap
